# Resend API key — used by src/app/api/contact/route.ts to send contact-form
# submissions to onahbernardchizoba@gmail.com. Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Public Google Calendar Appointment Schedule URL (with Google Meet as the
# location), used by the "Book a Call" CTA. Create one at
# https://calendar.google.com under Settings > Appointment schedules.
# Public by design — safe to expose client-side, contains no credentials.
# If unset, the "Book a Call" CTA hides itself instead of rendering a broken link.
NEXT_PUBLIC_BOOKING_URL=
